#!/bin/bash
# npw — np (nordpass) copy wizard. usage: npw <search>
# fuzzy-find an item, pick fields by number, copy to clipboard. ctrl+c quits.

trap 'printf "\n"; exit 130' INT

die() { printf '%s\n' "$*" >&2; exit 1; }

# np prints {"error":{...}} on failure; surface it calmly.
check() {
  local msg
  msg=$(jq -r 'if type=="object" and has("error") then .error.message + (if .error.hints then "\n" + (.error.hints|join("\n")) else "" end) else empty end' <<<"$1" 2>/dev/null)
  [ -n "$msg" ] && die "$msg"
}

q="$*"
[ -n "$q" ] || read -rp '> find ' q
[ -n "$q" ] || exit 0

all=$(np item list --format json 2>&1) || true
check "$all"

# every word must hit the title, any order: substring first, else letters-in-order ("gem nf").
hits=$(jq -c --arg q "$q" '
  ($q|ascii_downcase|split(" ")|map(select(.!=""))) as $w
  | ($w|map([explode[]|[.]|implode|select(test("[a-z0-9]"))]|join(".*"))) as $re
  | (if type=="array" then . else (.items // .data // []) end)
  | map({id: (.id // .uuid), title: (.title // .name // "?"), sub: (.username // .login // .url // .type // "")})
  | map(select(.title|ascii_downcase as $t|all($w[];. as $x|$t|contains($x)))) as $s
  | if ($s|length)>0 then $s else map(select(.title|ascii_downcase as $t|all($re[];. as $r|$t|test($r)))) end' <<<"$all") \
  || die "couldn't read np output."

n=$(jq length <<<"$hits" 2>/dev/null); n=${n:-0}
[ "$n" -gt 0 ] || die "no match for '$q'."

if [ "$n" -eq 1 ]; then
  i=0
else
  jq -r 'to_entries[] | "\(.key+1)  \(.value.title)\(if .value.sub!="" then "  · "+.value.sub else "" end)"' <<<"$hits"
  while :; do
    read -rp '> item ' i || { echo; exit 0; }
    [[ "$i" =~ ^[0-9]+$ ]] && [ "$i" -ge 1 ] && [ "$i" -le "$n" ] && { i=$((i-1)); break; }
    echo "1–$n."
  done
fi

id=$(jq -r ".[$i].id" <<<"$hits")
printf '%s\n' "$(jq -r ".[$i].title" <<<"$hits")"

item=$(np item get "$id" --format json 2>&1) || true
check "$item"

# fields = every non-empty scalar leaf except ids/metadata; label = nearest name/label, else key path.
fields=$(jq -c '
  (.item // .) as $it
  | [ $it | paths(scalars) as $p
      | select(($it|getpath($p)|tostring) != "")
      | select(($p[-1]|tostring) | test("^(id|uuid|type|kind|created|createdAt|updated|updatedAt|modifiedAt|folder|folderId|favorite|shared|version|revision)$";"i") | not)
      | select(($p[-1]|tostring) | test("^(name|label|title)$";"i") | not or ($p|length)==1)
      | { p: $p,
          l: ( ($p[:-1]) as $parent
               | ($it|getpath($parent)) as $o
               | if ($o|type)=="object" and ($p[-1]=="value") and (($o.name // $o.label)!=null)
                 then ($o.name // $o.label)
                 else ($p|map(tostring)|join(".")) end ) } ]' <<<"$item") \
  || die "couldn't read item."

m=$(jq length <<<"$fields")
[ "$m" -gt 0 ] || die "no fields."

jq -r 'to_entries[] | "\(.key+1)  \(.value.l)"' <<<"$fields"
while :; do
  read -rp '> copy ' f || { echo; exit 0; }
  [[ "$f" =~ ^[0-9]+$ ]] && [ "$f" -ge 1 ] && [ "$f" -le "$m" ] || { echo "1–$m."; continue; }
  p=$(jq -c ".[$((f-1))].p" <<<"$fields")
  jq -j --argjson p "$p" '(.item // .) | getpath($p) | tostring' <<<"$item" | pbcopy
  echo "copied $(jq -r ".[$((f-1))].l" <<<"$fields")."
done
