#!/bin/zsh
# yzkr-hotkey — hand ⌘Space from macOS Spotlight to Sol (which surfaces YZKR Spotlight + macros).
#   yzkr-hotkey          free ⌘Space (disable Spotlight hotkey 64) + set Sol to ⌘Space + restart Sol
#   yzkr-hotkey --undo   give ⌘Space back to Spotlight, Sol back to ⌥Space
set -euo pipefail

SOL_CFG="$HOME/.config/sol/config.json"
undo=false; [[ ${1:-} == --undo ]] && undo=true

# Spotlight "Show Spotlight search" = symbolic hotkey 64 (space=49, ⌘ mask=1048576)
if $undo; then enabled=true; sol_key=option; else enabled=false; sol_key=command; fi
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
  "<dict><key>enabled</key><$enabled/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1048576</integer></array><key>type</key><string>standard</string></dict></dict>"
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true

mkdir -p "${SOL_CFG:h}"
[[ -f $SOL_CFG ]] || print '{}' >"$SOL_CFG"
tmp=$(mktemp)
/opt/homebrew/bin/jq --arg k "$sol_key" '.globalShortcut = $k' "$SOL_CFG" >"$tmp" && mv "$tmp" "$SOL_CFG"

osascript -e 'quit app "Sol"' 2>/dev/null || true
sleep 1
open -a Sol
print "⌘Space → $([[ $sol_key == command ]] && print Sol || print Spotlight). If ⌘Space still opens Spotlight, log out/in once."
